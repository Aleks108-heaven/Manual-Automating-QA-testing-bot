              "id": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "source"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "source",
        "cases"
      ],
      "additionalProperties": false
    },
    "header": {

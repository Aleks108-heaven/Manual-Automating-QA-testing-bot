              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "BLOCKED": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "INCONCLUSIVE": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "INCOMPLETE": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "NOT_EXECUTED": {

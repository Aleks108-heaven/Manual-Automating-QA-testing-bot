  "required": [
    "schema_version",
    "run_id",
    "case",
    "started_at",
    "finished_at",
    "target",
    "versions",
    "steps",
    "observations",
    "outcomes",
    "evidence",
    "guardrail_events",
    "cleanup_errors",
    "session",
    "budget",
    "blocked",
    "preflight",
    "implicit",
    "judge",
    "model_output",
    "redaction",
    "artifact_scan",
    "artifacts",
    "run_state",
    "frozen",
    "verdict",
    "verdict_row"
  ],
  "additionalProperties": false
}

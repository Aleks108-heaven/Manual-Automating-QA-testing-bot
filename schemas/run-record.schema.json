    "budget": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "max_tool_calls_per_run": {
              "type": "number"
            },
            "max_tool_calls_per_step": {
              "type": "number"
            },
            "max_wall_ms": {
              "type": "number"
            },
            "max_cost_usd": {
              "type": "number"
            }
          },
          "required": [
            "max_tool_calls_per_run",
            "max_tool_calls_per_step",
            "max_wall_ms",
            "max_cost_usd"
          ],
          "additionalProperties": false
        },
        "used": {
          "type": "object",
          "properties": {
            "tool_calls": {
              "type": "number"
            },
            "wall_ms": {
              "type": "number"
            },
            "cost_usd": {
              "type": "number"
            },
            "input_tokens": {
              "type": "number"
            },
            "output_tokens": {
              "type": "number"
            }
          },
          "required": [
            "tool_calls",
            "wall_ms",
            "cost_usd",
            "input_tokens",
            "output_tokens"
          ],
          "additionalProperties": false
        },
        "stop": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string",
                  "enum": [
                    "budget",
                    "timeout"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "detail"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "limits",
        "used",
        "stop"
      ],
      "additionalProperties": false
    },
    "blocked": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "step": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "step_text": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "enum": [
                "element_missing",
                "step_ambiguous",
                "loop"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "actor",
                "runner"
              ]
            },
            "tool_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "step",
            "step_text",
            "reason",
            "source",
            "tool_error",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "preflight": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "ok": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "skipped"
                    ]
                  }
                },
                "required": [
                  "name",
                  "status"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "at",
            "ok",
            "checks"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "implicit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "console_error",
                  "http_error",
                  "failed_request",
                  "broken_image",
                  "accessibility"
                ]
              },
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "page": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "rule": {
                "type": "string"
              },
              "impact": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "kind",
              "step",
              "page",
              "detail",
              "count"
            ],
            "additionalProperties": false
          }
        },
        "counts": {
          "type": "object",
          "properties": {
            "console_error": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "http_error": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "failed_request": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "broken_image": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "accessibility": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "console_error",
            "http_error",
            "failed_request",
            "broken_image",
            "accessibility"
          ],
          "additionalProperties": false
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "findings",
        "counts",
        "truncated"
      ],
      "additionalProperties": false
    },
    "judge": {
      "type": "object",
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]

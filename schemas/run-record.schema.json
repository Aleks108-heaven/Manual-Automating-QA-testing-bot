  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 6
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "steps_total": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expected": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "after_step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "description": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "kind",
              "after_step",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "title",
        "priority",
        "source",
        "steps_total",
        "preconditions",
        "expected"
      ],
      "additionalProperties": false
    },
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "versions": {
      "type": "object",
      "properties": {
        "bot": {
          "type": "string"
        },
        "bot_source_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "node": {
          "type": "string"
        },
        "playwright": {
          "type": "string"
        },
        "axe_core": {
          "type": "string"
        },
        "browser": {
          "type": "string"
        },
        "browser_sandbox": {
          "type": "boolean"
        },
        "model_client": {
          "type": "string"
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "model_live": {
          "type": "boolean"
        },
        "prompt_hashes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "config_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "build": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "bot",
        "bot_source_hash",
        "node",
        "playwright",
        "axe_core",
        "browser",
        "browser_sandbox",
        "model_client",
        "model_id",
        "model_live",
        "prompt_hashes",
        "config_hash",
        "build"
      ],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "text": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tool": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "ok": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                },
                "resolved_locator": {
                  "type": "string"
                }
              },
              "required": [
                "tool",
                "args",
                "ok"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "index",
          "text",
          "actions"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expected_ref": {
            "type": "string"
          },
          "observed": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "expected_ref",
          "observed",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "expected_ref": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "MATCH",
              "MISMATCH",
              "NO_EVIDENCE"
            ]
          },
          "after_step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "expected_ref",
          "kind",
          "outcome",
          "after_step",
          "expected",
          "actual",
          "detail",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "screenshot",
              "snapshot",
              "network"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "expected_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "path",
          "step"
        ],
        "additionalProperties": false
      }
    },
    "guardrail_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "navigation",
              "request",
              "popup",
              "frame",
              "websocket",
              "scheme",
              "mutation"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "allowed",
              "blocked"
            ]
          },
          "url": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "at",
          "type",
          "decision",
          "url",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "cleanup_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "session": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "const": "per-case"
        },
        "established": {
          "type": "boolean"
        }
      },
      "required": [
        "role",
        "mode",
        "established"
      ],
      "additionalProperties": false

        "model_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "live": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "injection_reports": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "configured",
        "name",
        "model_id",
        "live",
        "calls",
        "attempts",
        "errors",
        "injection_reports"
      ],
      "additionalProperties": false
    },
    "model_output": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "valid": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "attempts",
        "valid",
        "errors"
      ],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "secrets_tracked": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "replacements": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "secrets_tracked",
        "replacements"
      ],
      "additionalProperties": false
    },
    "artifact_scan": {
      "type": "object",
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "findings": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "cleaned": {
          "type": "boolean"
        }
      },
      "required": [
        "files_scanned",
        "findings",
        "cleaned"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "har": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_context": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "har",
        "model_context"
      ],
      "additionalProperties": false
    },
    "run_state": {
      "type": "object",
      "properties": {
        "actor_stop_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "element_missing",
                "step_ambiguous",
                "loop"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "stop_source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "actor",
                "runner"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "runner_stop_reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "budget",
                "timeout",
                "crash",
                "killed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "infrastructure_failure": {
          "type": [
            "string",
            "null"
          ]
        },
        "guardrail_block": {
          "type": "boolean"
        },
        "injection_suspected": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_stop_reason",
        "stop_source",
        "runner_stop_reason",
        "infrastructure_failure",
        "guardrail_block",
        "injection_suspected"
      ],
      "additionalProperties": false
    },
    "frozen": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string",
              "minLength": 1
            },
            "script_version": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "script_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "case_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "reengagement": {
              "type": "string",
              "enum": [
                "not_needed",
                "not_requested",
                "proposal_written",
                "proposal_invalid"
              ]
            },
            "proposal_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "proposal_attempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "proposal_errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "case_id",
            "script_version",
            "script_hash",
            "case_hash",
            "reengagement",
            "proposal_file",
            "proposal_attempts",
            "proposal_errors"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCONCLUSIVE",
        "INCOMPLETE"
      ]
    },
    "verdict_row": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    }

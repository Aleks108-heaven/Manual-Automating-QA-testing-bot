{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "scripts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^TC-[A-Z]+-\\d{3}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "script_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "case_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "approved_by": {
            "type": "string",
            "minLength": 1
          },
          "approved_on": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "case_id",
          "version",
          "file",
          "script_hash",
          "case_hash",
          "approved_by",
          "approved_on",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "scripts"
  ],
  "additionalProperties": false
}

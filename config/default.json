{
  "_comment": "Fixture-only defaults for M1. Every value here corresponds to a [to fill] in the manual and must be reviewed before the pilot. Environment variables override these values (see src/config.ts). The runner always adds the target's own host and port to the allowlist.",
  "allowlist": {
    "hosts": [],
    "schemes": ["http:", "https:"]
  },
  "budgets": {
    "maxToolCallsPerRun": 60,
    "maxToolCallsPerStep": 8,
    "maxWallMs": 120000,
    "maxCostUsd": 1
  },
  "pricing": {
    "inputPerMTok": 3,
    "outputPerMTok": 15
  },
  "mutations": {
    "alwaysAllow": [],
    "stateChangingGets": ["/logout", "/signout", "/sign-out", "/delete*", "/remove*"]
  },
  "implicit": {
    "enabled": true,
    "accessibility": true,
    "maxFindings": 50
  },
  "judge": {
    "maxAttempts": 3
  },
  "modelOutput": {
    "maxAttempts": 3
  },
  "loop": {
    "failureLimit": 3,
    "repeatLimit": 8
  },
  "tools": {
    "actionTimeoutMs": 3000,
    "navigationTimeoutMs": 10000
  },
  "browser": {
    "sandbox": true
  },
  "oracle": {
    "assertionTimeoutMs": 5000,
    "assertionPollMs": 100,
    "stabilityMs": 250,
    "settleQuietMs": 150,
    "settleMaxMs": 2000
  },
  "roles": {
    "member": {
      "login": {
        "path": "/api/login",
        "usernameField": "username",
        "passwordField": "password",
        "username": "secret:fixture_member.username",
        "password": "secret:fixture_member.password"
      },
      "verifyPath": "/account"
    }
  },
  "sessions": {
    "mode": "per-case",
    "directory": "${TMPDIR}/qa-bot-sessions"
  },
  "testApi": {
    "headers": { "x-fixture-test": "1" }
  },
  "runs": {
    "directory": "runs"
  }
}
